+/* Transmitter-rack animations for the Stations page (Stations.dc.html design).
+   Scoped here because Tailwind utilities can't declare keyframes, and the
+   admin's no-inline-style rule applies to the JSX, not co-located modules. */
+
+.blink {
+  animation: blink 1.1s steps(1) infinite;
+}
+@keyframes blink {
+  0%, 55% { opacity: 1; }
+  56%, 100% { opacity: 0.12; }
+}
+
+/* Five-bar VU meter inside the ON AIR chip. Per-bar duration/phase offsets
+   keep the bars visibly out of step, like a real meter. */
+.vuBar {
+  transform-origin: bottom;
+  animation: vu 0.5s ease-in-out infinite alternate;
+}
+.vuBar:nth-child(1) { animation-duration: 0.5s;  animation-delay: -0.1s; }
+.vuBar:nth-child(2) { animation-duration: 0.38s; animation-delay: -0.3s; }
+.vuBar:nth-child(3) { animation-duration: 0.62s; animation-delay: -0.2s; }
+.vuBar:nth-child(4) { animation-duration: 0.45s; animation-delay: -0.05s; }
+.vuBar:nth-child(5) { animation-duration: 0.55s; animation-delay: -0.4s; }
+@keyframes vu {
+  from { transform: scaleY(0.15); }
+  to { transform: scaleY(1); }
+}
+
+/* Barber-pole progress bar on the switching overlay. */
+.stripes {
+  background: repeating-linear-gradient(
+    45deg,
+    var(--accent) 0,
+    var(--accent) 6px,
+    transparent 6px,
+    transparent 12px
+  );
+  animation: stripes 0.5s linear infinite;
+}
+@keyframes stripes {
+  from { background-position: 0 0; }
+  to { background-position: 17px 0; }
+}
+
+.shimmer {
+  animation: shimmer 1.4s infinite;
+}
+@keyframes shimmer {
+  0%, 100% { opacity: 0.55; }
+  50% { opacity: 0.15; }
+}
+
+/* FM band tick marks: fine ticks every 11px, coarse every 55px. */
+.dialFine {
+  background-image: repeating-linear-gradient(
+    90deg,
+    var(--separator-strong) 0,
+    var(--separator-strong) 1px,
+    transparent 1px,
+    transparent 11px
+  );
+}
+.dialCoarse {
+  background-image: repeating-linear-gradient(
+    90deg,
+    var(--ink) 0,
+    var(--ink) 1px,
+    transparent 1px,
+    transparent 55px
+  );
+}
